# AutoShorts Environment Configuration

# Application
APP_ENV=development
DEBUG=True
SECRET_KEY=change-this-to-a-secure-random-secret-key
BASE_URL=http://localhost:8000

# Storage & Paths
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/database/autoshorts.db
MEDIA_STAGING_DIR=./data/media_staging

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# AI Inference Primary (Google Gemini 1.5 Flash Free Tier)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_SECONDS=8.0

# AI Inference Fallback (Local Ollama Qwen 2.5 3B)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# YouTube Data API & Analytics API v3
YOUTUBE_CLIENT_SECRETS_FILE=./data/client_secrets.json
YOUTUBE_CREDENTIALS_FILE=./data/youtube_credentials.json
YOUTUBE_DAILY_QUOTA_LIMIT=10000
YOUTUBE_UPLOAD_QUOTA_COST=1600

# Telegram Bot (aiogram 3.x)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_USERS=your_telegram_user_id

# Deduplication Thresholds
DUP_RISK_THRESHOLD=0.75
WEIGHT_AUDIO_MATCH=0.50
WEIGHT_TFIDF_COSINE=0.30
WEIGHT_LEVENSHTEIN=0.20

